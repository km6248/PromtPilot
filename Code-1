<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>PromptPilot | AI Prompt Analyzer</title>
  <link rel="stylesheet" href="{{ url_for('static', filename='style.css') }}">
</head>
<body>
  <header class="topbar">
    <div class="brand"><span class="logo">✦</span> PromptPilot</div>
    <span class="tag">AI PROMPT ANALYZER</span>
  </header>
  <main class="container">
    <section class="hero">
      <p class="eyebrow">WRITE BETTER PROMPTS</p>
      <h1>Turn your ideas into<br><span>powerful prompts.</span></h1>
      <p class="sub">Analyze, improve, and optimize your prompts with a simple smart assistant.</p>
    </section>
    <section class="panel">
      <label for="prompt">Enter your prompt</label>
      <textarea id="prompt" placeholder="Example: Explain how artificial intelligence helps students learn more effectively. Give 5 practical examples in simple language..."></textarea>
      <div class="actions">
        <span id="counter">0 characters</span>
        <button id="analyzeBtn" onclick="analyzePrompt()">Analyze my prompt&nbsp; →</button>
      </div>
      <p id="error" class="error"></p>
    </section>
    <section id="results" class="results hidden">
      <div class="result-head">
        <div><p class="eyebrow">YOUR PROMPT REPORT</p><h2>Analysis results</h2></div>
        <div class="score"><strong id="score">0</strong><small>/ 100</small></div>
      </div>
      <div class="progress"><div id="progressFill"></div></div>
      <div class="columns">
        <div class="result-card">
          <h3>Quality checklist</h3>
          <div id="checks"></div>
        </div>
        <div class="result-card">
          <h3>Improvement suggestions</h3>
          <ul id="suggestions"></ul>
        </div>
      </div>
      <div class="result-card improved-card">
        <div class="improved-title"><h3>Optimized prompt</h3><button class="secondary" onclick="copyPrompt()">Copy prompt</button></div>
        <pre id="improved"></pre>
        <p id="copied" class="copied"></p>
      </div>
    </section>
    <footer>PromptPilot · Built for AI VIBEATHON 2026 · PromptWars</footer>
  </main>
  <script>
    const promptBox = document.getElementById("prompt");
    promptBox.addEventListener("input", () => {
      document.getElementById("counter").textContent = promptBox.value.length + " characters";
    });
    async function analyzePrompt() {
      const prompt = promptBox.value.trim();
      const error = document.getElementById("error");
      const btn = document.getElementById("analyzeBtn");
      error.textContent = "";
      if (prompt.length < 3) { error.textContent = "Please enter a prompt first."; return; }
      btn.disabled = true; btn.textContent = "Analyzing...";
      try {
        const response = await fetch("/analyze", {
          method: "POST", headers: {"Content-Type": "application/json"},
          body: JSON.stringify({prompt})
        });
        const data = await response.json();
        if (!response.ok) throw new Error(data.error || "Something went wrong.");
        document.getElementById("results").classList.remove("hidden");
        document.getElementById("score").textContent = data.score;
        document.getElementById("progressFill").style.width = data.score + "%";
        document.getElementById("checks").innerHTML = Object.entries(data.checks).map(([name, ok]) =>
          `<div class="check"><span>${name}</span><b class="${ok ? 'yes' : 'no'}">${ok ? '✓ Present' : '＋ Add'}</b></div>`
        ).join("");
        document.getElementById("suggestions").innerHTML = data.suggestions.map(s => `<li>${s}</li>`).join("");
        document.getElementById("improved").textContent = data.improved;
        document.getElementById("copied").textContent = "";
        document.getElementById("results").scrollIntoView({behavior: "smooth"});
      } catch (e) { error.textContent = e.message; }
      finally { btn.disabled = false; btn.textContent = "Analyze my prompt →"; }
    }
    async function copyPrompt() {
      const text = document.getElementById("improved").textContent;
      try {
        await navigator.clipboard.writeText(text);
        document.getElementById("copied").textContent = "Copied to clipboard!";
      } catch { document.getElementById("copied").textContent = "Select and copy the prompt manually."; }
    }
  </script>
</body>
</html>
